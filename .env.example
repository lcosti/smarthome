# Local development. The local stack's keys are fixed demo values, so this file is
# safe to commit — `pnpm supabase start` prints the same ones every time.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

# These are read at BUILD time and baked into the static bundle. On Netlify they
# must be set as site environment variables before the first deploy.

# Needed only to run `pnpm acceptance`. Left blank here because GitHub's secret
# scanner blocks any push containing a service-role key, even a local demo one.
# Copy it out of `pnpm supabase status` into your own .env, which is gitignored.
SUPABASE_SECRET_KEY=
