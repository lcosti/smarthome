# Secrets for the Edge Functions, used only when serving them locally:
#   pnpm supabase functions serve import-recipe-photo --env-file supabase/functions/.env
#
# In production these are set on the project instead, and never live in a file:
#   pnpm supabase secrets set ANTHROPIC_API_KEY=<key>
ANTHROPIC_API_KEY=

# sync-calendar refuses every request unless this is set — it runs as the service
# role with verify_jwt off, so an unset secret would leave it open. Any string
# will do locally; in production it must match the vault's sync_calendar_secret.
SYNC_SECRET=local-dev
